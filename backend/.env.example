# RiskShield AI — Backend Environment Configuration
PROJECT_NAME="RiskShield AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riskshield_db
POSTGRES_USER=riskshield_user
POSTGRES_PASSWORD=your_postgres_password_here

# Direct Database URL (Optional override)
# DATABASE_URL=postgresql+asyncpg://riskshield_user:your_postgres_password_here@localhost:5432/riskshield_db

# CORS Configuration (comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
