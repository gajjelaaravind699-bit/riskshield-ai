# ==============================================================================
# RiskShield AI — Backend Environment Template
# ==============================================================================
PROJECT_NAME="RiskShield AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false

# Security & Keys
SECRET_KEY="generate_a_random_32_plus_character_secret_key_here!"
AUTH_ENABLED=true
API_KEY_HEADER_NAME="X-API-Key"
API_KEYS={"rs_live_analyst_key_example_12345":{"identity":"lead-analyst","role":"analyst","scopes":["read","write","analyst"]}}

# Server
HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS=["*"]
ENABLE_SECURITY_HEADERS=true

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=10485760

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="riskshield_db"
POSTGRES_USER="riskshield_user"
POSTGRES_PASSWORD="your_secure_postgres_password_here"

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
