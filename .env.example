# ==============================================================================
# RiskShield AI — Environment Configuration Example (Production & Development)
# ==============================================================================
# Copy this file to .env for local Docker/production deployment:
#   cp .env.example .env

# --- Environment & Security ---
# Allowed values: development, test, staging, production
ENVIRONMENT=production
DEBUG=false

# Must be a cryptographically strong random string (minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_cryptographically_strong_random_secret_key_at_least_32_chars!

# API Key Authentication (JSON format mapping keys to roles: admin, analyst, ingest)
# Generate production keys with: python -c "import secrets; print('rs_live_' + secrets.token_hex(16))"
API_KEYS={"rs_live_analyst_key_example_12345":{"identity":"lead-analyst","role":"analyst","scopes":["read","write","analyst"]},"rs_live_ingest_key_example_67890":{"identity":"payment-worker","role":"ingest","scopes":["write","ingest"]}}
AUTH_ENABLED=true

# --- Server & Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1","yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# --- Rate Limiting & Protection ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=10485760

# --- Logging & Observability ---
# Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: json (production) or text (local debug)
LOG_FORMAT=json

# --- PostgreSQL Database ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=riskshield_db
POSTGRES_USER=riskshield_user
POSTGRES_PASSWORD=your_secure_random_postgres_password_here

# Database Reliability Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# --- Frontend Console ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: Frontend API key for analyst dashboard access
NEXT_PUBLIC_API_KEY=rs_live_analyst_key_example_12345
